# Ente KSRTC Backend — Environment Configuration
# ------------------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.

PORT=5011

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DBNAME

JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_EXPIRE=7d

NODE_ENV=development

# ─── PAYMENT CONFIGURATION ────────────────────────────────────────────────────
# SIMULATED: No real money moves. Use for local development.
# RAZORPAY:  Requires RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET (TEST MODE only).
#
# ⚠ IMPORTANT: Use TEST MODE credentials only. NEVER use live credentials in dev.
# ⚠ NEVER expose RAZORPAY_KEY_SECRET to the frontend.
#
PAYMENT_PROVIDER=SIMULATED

# Razorpay TEST MODE credentials
# Get from: https://dashboard.razorpay.com/app/keys (switch to TEST mode first)
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET

# Razorpay webhook secret
# Created when you configure the webhook in Razorpay dashboard
# Webhook URL: https://your-backend-url/api/bookings/webhook
# Events to subscribe: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Simulated payment webhook secret (SIMULATED mode only)
PAYMENT_WEBHOOK_SECRET=sim-webhook-secret

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Firebase (base64-encoded service account JSON)
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
